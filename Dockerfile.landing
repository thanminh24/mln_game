# syntax=docker/dockerfile:1

# ----------------------------------------------------------------------------
# MLN Landing Page — static site served via nginx:alpine.
# Uses pnpm. The _content dir is aliased as @content in the Vite config and
# must be present alongside 01-apple-fluid during the build.
# ----------------------------------------------------------------------------

FROM node:22-alpine AS builder
WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@latest --quiet

# Copy manifests first for layer caching
COPY MLN_landing_page/01-apple-fluid/package.json \
     MLN_landing_page/01-apple-fluid/pnpm-lock.yaml \
     ./MLN_landing_page/01-apple-fluid/

RUN cd MLN_landing_page/01-apple-fluid && pnpm install --frozen-lockfile --ignore-scripts

# Copy source — both the app and the shared _content it aliases
COPY MLN_landing_page/01-apple-fluid ./MLN_landing_page/01-apple-fluid
COPY MLN_landing_page/_content        ./MLN_landing_page/_content

RUN cd MLN_landing_page/01-apple-fluid && pnpm run build

# ---- Runtime: nginx serving the built static files ----
FROM nginx:alpine AS runtime

COPY --from=builder /app/MLN_landing_page/01-apple-fluid/dist /usr/share/nginx/html

# Serve on port 80; 404 falls back to index.html (standard SPA pattern)
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / { try_files $uri $uri/ /index.html; }\n}\n' \
    > /etc/nginx/conf.d/default.conf

EXPOSE 80
